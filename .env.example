# Network Gateway API configuration reference. All example credentials are fake.
#
# Management storage reads PROCESS environment variables. Copying this file to
# .env alone does not configure management storage. The legacy configuration
# loader may read .env; the isolated demo bootstrap handles its own settings.
#
# Choose exactly one storage option and provide a persistent Fernet key:
# GATEWAY_SQLITE_PATH=D:\gateway-data\gateway.sqlite3
# GATEWAY_DATABASE_URL=postgresql+psycopg2://fake_user:fake_password@localhost:5432/fake_gateway
# GATEWAY_SECRET_KEY=<a Fernet key supplied through protected server configuration>
# GATEWAY_DEVICE_DATA_PROVIDER=disabled
#
# Set GATEWAY_DEVICE_DATA_PROVIDER=fake only to enable explicitly fake profiles.
# Network profiles never fall back to fictional inventory.
#
# Application authentication:
# GATEWAY_AUTH_MODE=entra
# GATEWAY_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# GATEWAY_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# GATEWAY_ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# GATEWAY_ENTRA_CLIENT_SECRET=<protected server-side secret, never commit>
# GATEWAY_ENTRA_REDIRECT_URIS=http://localhost:8000/api/v1/callback,https://gateway.example.com/api/v1/callback
# GATEWAY_ENTRA_POST_LOGOUT_REDIRECT_URI=https://gateway.example.com/
# GATEWAY_ENTRA_SCOPES=openid,profile,email
#
# Offline demo only (requires demo mode too):
# GATEWAY_AUTH_MODE=demo
# GATEWAY_DEMO_USER_ID=demo-engineer
# GATEWAY_DEMO_USER_NAME=Demo Network Engineer
# GATEWAY_DEMO_USER_EMAIL=demo-engineer@example.invalid
# GATEWAY_DEMO_USER_ROLE=Administrator
#
# Never generate a replacement key for an existing database. Keep and back up
# the original key separately; losing it makes stored credentials unreadable.
# For the fake-credential loopback demo, use python -m demo.run_demo instead.

# Legacy metadata database settings (separate from /api/v1 management profiles)
DB_HOST=fake-postgres-db.example.com
DB_PORT=5432
DB_NAME=fake_db_name
DB_USER=fake_db_user
DB_PASSWORD=fake_db_password

# Router credentials
ROUTER_USERNAME=fake_router_user
ROUTER_PASSWORD=fake_router_pass

# Proxy credentials
PROXY_USERNAME=fake_proxy_user
PROXY_PASSWORD=fake_proxy_pass

# Device lookup, client dispatch and proxy mappings are persisted in the
# management database, not configured through JSON file paths.
