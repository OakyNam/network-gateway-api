# Environment for the Network Gateway API loopback demo profile.
#
# This is NOT a production environment file. All credentials below are fake,
# used only to authenticate against the local loopback emulators started by
# `demo/run_demo.py`. Nothing here talks to real hardware, cloud services, or
# a production database.
#
# Load with (PowerShell):
#   Get-Content demo/.env.demo | ForEach-Object {
#     if ($_ -match '^\s*#') { return }
#     if ($_ -match '^\s*$') { return }
#     $name, $value = $_.Split('=', 2)
#     Set-Item -Path "Env:$name" -Value $value
#   }
# `demo/run_demo.py` does this for you automatically.

# --- Database (SQLite demo backend, not production PostgreSQL) ---
DB_BACKEND=sqlite
DB_SQLITE_PATH=./demo/data/demo_devices.sqlite3

# Legacy dispatch and metadata lookup mappings are seeded into gateway.sqlite3.
# Do not export CLIENT_CONFIG_PATH, PROXY_CONFIG_PATH or DB_CLIENT_CONFIG_PATH.

# --- Fallback router credentials (unused when a device row supplies its own
#     fake username/password, which the seeded demo devices do) ---
ROUTER_USERNAME=demo-fake-user
ROUTER_PASSWORD=demo-fake-pass

# --- Fake bastion credentials for local proxy emulators ---
PROXY_USERNAME=demo-fake-proxy-user
PROXY_PASSWORD=demo-fake-proxy-pass

# --- Host-key trust for the loopback SSH/NETCONF emulators ---
# Real host-key verification stays enabled (hostkey_verify=True / RejectPolicy);
# this only tells the client where the *demo* known_hosts file lives.
ROUTER_NETCONF_HOSTKEY_VERIFY=true
ROUTER_KNOWN_HOSTS_PATH=./demo/data/demo_known_hosts
ROUTER_SSH_CONFIG_PATH=./demo/data/demo_ssh_config

# --- Bounded timeouts for demo connections ---
ROUTER_CONNECT_TIMEOUT=8
ROUTER_TELNET_TIMEOUT=5

# Management storage/key paths are selected by demo.run_demo, never inherited.
# Use: python -m demo.run_demo --storage-dir <explicit-local-directory>
GATEWAY_DEMO_MODE=true

# Explicit fake application identity for the isolated offline demo. This is
# accepted only when demo.run_demo also enables application demo mode.
GATEWAY_AUTH_MODE=demo
GATEWAY_DEMO_USER_ID=demo-network-admin
GATEWAY_DEMO_USER_NAME=Demo Network Administrator
GATEWAY_DEMO_USER_EMAIL=demo-admin@example.invalid
GATEWAY_DEMO_USER_ROLE=Administrator

# Only explicitly fake management profiles use simulated device data.
# The seven network profiles still authenticate against real loopback peers.
GATEWAY_DEVICE_DATA_PROVIDER=fake
